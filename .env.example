# ─────────────────────────────────────────────────────────────────────────────
# MediaDock — environment variables (API + worker)
#
# Local development:  copy this file to `.env` in the repository root.
# Production:         set the same variables in your host's dashboard (Render, Railway, …).
#                     NEVER commit a real `.env`. Both are read by `loadConfig()` in
#                     packages/core/src/config.ts, which validates everything at boot.
#
# Two ways to run (see README):
#  - Standalone (one Next.js app, e.g. on Vercel): set these in apps/web/.env.local or the Vercel
#    project — MEDIADOCK_MODE=standalone, ACCESS_PASSWORD(_HASH), SESSION_SECRET (+ Vercel Blob).
#  - Self-hosted API + worker + Redis: this file is for those two; the web app then only needs
#    API_BASE_URL (apps/web/.env.example).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development          # development | production | test
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent

# ── Private access (API) ─────────────────────────────────────────────────────
# Generate the hash with:  npm run hash-password      (prompts; input hidden)
# Use the hash in production. ACCESS_PASSWORD (plain text) is only a local-dev convenience.
ACCESS_PASSWORD_HASH=
ACCESS_PASSWORD=
# >= 32 random characters. Signs session cookies and download/upload links.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production. If unset in development a random per-process secret is used
# (so everyone is signed out on every restart).
SESSION_SECRET=
SESSION_TTL_HOURS=168         # how long a sign-in lasts (default 7 days)

# ── API server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4000
# Public URL of THIS API. Used to build signed download/upload links for the local storage driver.
API_PUBLIC_URL=http://localhost:4000
# Browser origin(s) allowed to call the API directly (the upload PUT). Comma separated, no wildcard in production.
WEB_ORIGIN=http://localhost:3000
# true when running behind a proxy/load balancer (Render, Railway, Fly) so client IPs come from X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=120     # global per-IP; sensitive routes have stricter built-in limits

# ── Redis (job queue + shared rate limits) ───────────────────────────────────
# Managed Redis must use maxmemory-policy "noeviction" or BullMQ jobs can be dropped.
# Use rediss:// for TLS (Upstash, Render Key Value external URL, Railway TCP proxy, …).
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2          # parallel conversions per worker process
JOB_MAX_ATTEMPTS=2            # transient failures are retried with exponential back-off

# ── Storage ──────────────────────────────────────────────────────────────────
# local: files on disk (dev, tests, or API+worker on ONE machine sharing a disk).
# s3:    Cloudflare R2 / AWS S3 / MinIO — required when API and worker are separate services.
STORAGE_DRIVER=local
# Relative paths resolve from the directory you start the process in (the repo root for `npm run dev`).
STORAGE_LOCAL_DIR=./.data/storage

# Cloudflare R2: endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region "auto".
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false     # true for MinIO / most self-hosted S3

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_INPUT_MB=1024             # largest source file (download or upload)
MAX_OUTPUT_MB=2048            # largest converted file
MAX_DURATION_MINUTES=240      # longest media accepted
DOWNLOAD_TIMEOUT_MINUTES=15   # fetching a source from a platform CDN
PROCESSING_TIMEOUT_MINUTES=30 # FFmpeg wall-clock limit per job
FILE_TTL_MINUTES=60           # converted files are deleted after this
DOWNLOAD_LINK_TTL_SECONDS=600 # lifetime of one signed download link (a fresh one is issued on demand)

# ── FFmpeg (worker) ──────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe           # "none" = inspect files with ffmpeg instead (serverless)

# ── yt-dlp (link downloads) ──────────────────────────────────────────────────
# Install yt-dlp (https://github.com/yt-dlp/yt-dlp) or point to it. Keep it up to date: sites change.
YTDLP_PATH=yt-dlp
# Optional. YouTube blocks most cloud/datacenter servers ("confirm you're not a bot"). Running at home
# avoids that; otherwise you can give the server cookies from a logged-in browser session, in Netscape
# cookies.txt format, either as a file path or as the file's contents. Use a spare account: Google may
# flag accounts used this way, and the cookies expire periodically.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES=
# JavaScript runtime yt-dlp uses for YouTube. Defaults to the Node.js binary running MediaDock.
YTDLP_JS_RUNTIME=
X264_PRESET=veryfast          # speed/size trade-off when a video has to be re-encoded to H.264
