# Copy to apps/web/.env.local for local development. Server-side only — never exposed to the browser.

# ── Option A: standalone (the whole app runs in Next.js; this is how the Vercel deployment runs)
MEDIADOCK_MODE=standalone
ACCESS_PASSWORD=change-me-to-a-long-password
# SESSION_SECRET is required in production (>= 32 chars); in dev a random one is used if empty.
SESSION_SECRET=
# yt-dlp on your PATH is used by default; point at a specific binary if needed.
# YTDLP_PATH=C:\tools\yt-dlp.exe
# Optional, see the root .env.example: YTDLP_COOKIES / YTDLP_COOKIES_FILE for YouTube from cloud servers.
# On Vercel, BLOB_READ_WRITE_TOKEN is added automatically when a Blob store is connected.

# ── Option B: proxy to the self-hosted API + worker (uploads, long videos, background jobs)
# MEDIADOCK_MODE=proxy
# API_BASE_URL=http://localhost:4000
